generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "sqlite"
    url      = env("DATABASE_URL_PRISMA")
}

model Project {
    id String @id

    name   String
    active Boolean

    script Bytes?

    @@map("project")
}
